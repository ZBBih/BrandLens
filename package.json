    "html2canvas": "^1.4.1",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.564.0",
    "next": "16.3.6",
    "playwright": "^1.58.2",
    "prisma": "5.22.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
