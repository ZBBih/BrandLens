generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Report {
  id     String @id @default(uuid())
  domain String
  status String // queued, crawling, extracting, analyzing, generating, completed, failed

  progress  String? // JSON: { step, currentUrl?, pagesProcessed?, phaseStartedAt? }
  data      String? // JSON BrandReport; partial while running, full once completed
  overrides String? // JSON ReportOverrides: owner edits layered on top of data
  error     String? // user-safe failure message

  createdAt   DateTime  @default(now())
  heartbeatAt DateTime? // bumped while the job runs; a stale heartbeat means the job died
  completedAt DateTime?
  expiresAt   DateTime // cache expiry: completedAt + 24h

  // SHA-256 of the owner's capability token. The raw token only ever lives in
  // the creator's httpOnly cookie, never in the database or any response body.
  ownerTokenHash String?
  sourceReportId String? // set when this report was cloned from a cached one

  assetsRegenerateCount Int @default(0)

  slug        String  @unique
  isPublic    Boolean @default(false)
  publicViews Int     @default(0)

  @@index([domain, status, createdAt])
}

model RateLimitCounter {
  key   String // e.g. "analyze:ip:<ip>", "analyze:global", "pdf:ip:<ip>"
  day   String // UTC date, YYYY-MM-DD
  count Int    @default(0)

  @@id([key, day])
}
