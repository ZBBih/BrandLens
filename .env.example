# PostgreSQL connection string (local: `docker run -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16`)
DATABASE_URL="postgresql://postgres:dev@localhost:5432/brandlens"

# Required - Claude API for tone, summary, marketing copy and insights
ANTHROPIC_API_KEY=

# Optional - Claude model override (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional - Enables brand data from Brandfetch
BRANDFETCH_API_KEY=

# Optional - how many reverse proxies sit in front of the app. The client IP is
# read this many entries from the right of X-Forwarded-For. Vercel: 1 (default).
# TRUSTED_PROXY_HOPS=1

# Vercel - protects the daily retention cron (/api/cron/retention). Any long
# random string; Vercel sends it automatically as a bearer token.
# CRON_SECRET=

# Optional - public site URL for share-preview images (defaults to Vercel's
# production domain)
# NEXT_PUBLIC_SITE_URL=https://brandlens.example
